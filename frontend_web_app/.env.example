# Frontend environment variables

# Base URL for your backend API. Must point to the server that exposes /ai/perplexity/suggest, etc.
# Example (local dev backend running on port 4000):
# REACT_APP_API_BASE_URL=http://localhost:4000
REACT_APP_API_BASE_URL=http://localhost:4000

# Optional: Axios request timeout in milliseconds
REACT_APP_API_TIMEOUT_MS=15000
